<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_field_list" model="ir.ui.view">
        <field name="name">agri.field.list</field>
        <field name="model">agri.field</field>
        <field name="arch" type="xml">
            <list string="Fields">
                <field name="name"/>
                <field name="farm_id"/>
                <field name="size_hectares"/>
                <field name="soil_type"/>
            </list>
        </field>
    </record>

    <record id="view_agri_field_form" model="ir.ui.view">
        <field name="name">agri.field.form</field>
        <field name="model">agri.field</field>
        <field name="arch" type="xml">
            <form string="Field">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="farm_id"/>
                        <field name="size_hectares"/>
                        <field name="soil_type"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_field" model="ir.actions.act_window">
        <field name="name">Fields</field>
        <field name="res_model">agri.field</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
