<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_crop_list" model="ir.ui.view">
        <field name="name">agri.crop.list</field>
        <field name="model">agri.crop</field>
        <field name="arch" type="xml">
            <list string="Crops">
                <field name="name"/>
                <field name="growth_days"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <record id="view_agri_crop_form" model="ir.ui.view">
        <field name="name">agri.crop.form</field>
        <field name="model">agri.crop</field>
        <field name="arch" type="xml">
            <form string="Crop">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="growth_days"/>
                        <field name="product_id"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_crop" model="ir.actions.act_window">
        <field name="name">Crops</field>
        <field name="res_model">agri.crop</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
