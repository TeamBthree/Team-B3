<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_farm_list" model="ir.ui.view">
        <field name="name">agri.farm.list</field>
        <field name="model">agri.farm</field>
        <field name="arch" type="xml">
            <list string="Farms">
                <field name="name"/>
                <field name="location"/>
                <field name="owner_id"/>
                <field name="size_hectares"/>
                <field name="field_count"/>
            </list>
        </field>
    </record>

    <record id="view_agri_farm_form" model="ir.ui.view">
        <field name="name">agri.farm.form</field>
        <field name="model">agri.farm</field>
        <field name="arch" type="xml">
            <form string="Farm">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="location"/>
                        <field name="owner_id"/>
                        <field name="size_hectares"/>
                    </group>
                    <notebook>
                        <page string="Fields">
                            <field name="field_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="size_hectares"/>
                                    <field name="soil_type"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_farm" model="ir.actions.act_window">
        <field name="name">Farms</field>
        <field name="res_model">agri.farm</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
