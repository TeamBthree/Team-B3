<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_agri_planting_list" model="ir.ui.view">
        <field name="name">agri.planting.list</field>
        <field name="model">agri.planting</field>
        <field name="arch" type="xml">
            <list string="Plantings" decoration-info="state == 'planned'"
                  decoration-success="state == 'growing'"
                  decoration-muted="state == 'harvested'"
                  decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="field_id"/>
                <field name="crop_id"/>
                <field name="planting_date"/>
                <field name="expected_harvest_date"/>
                <field name="quantity_planted"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_agri_planting_form" model="ir.ui.view">
        <field name="name">agri.planting.form</field>
        <field name="model">agri.planting</field>
        <field name="arch" type="xml">
            <form string="Planting">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,growing,harvested"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="field_id"/>
                            <field name="crop_id"/>
                        </group>
                        <group>
                            <field name="planting_date"/>
                            <field name="expected_harvest_date"/>
                            <field name="quantity_planted"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Farm Activities">
                            <field name="activity_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="activity_type"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Harvests">
                            <field name="harvest_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="harvest_date"/>
                                    <field name="quantity"/>
                                    <field name="quality_grade"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agri_planting" model="ir.actions.act_window">
        <field name="name">Plantings</field>
        <field name="res_model">agri.planting</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
